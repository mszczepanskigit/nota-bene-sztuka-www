# Every PUBLIC_* value is included in browser code. Never put a private secret here.
# Vercel preview and production builds require non-placeholder webinar and Web3Forms values.
PUBLIC_INSTAGRAM_URL=https://www.instagram.com/notabenesztuka
PUBLIC_SUPERPROF_URL=https://www.superprof.pl/example-profile
PUBLIC_CONTACT_EMAIL=kontakt@example.com
PUBLIC_WEBINAR_FORM_URL=https://forms.example.com/example-form
PUBLIC_WEB3FORMS_KEY=replace-with-a-public-web3forms-access-key
