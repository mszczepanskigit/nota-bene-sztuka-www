---
import { createBaseStructuredData, type JsonLdNode } from '../config/structuredData';

interface Props {
	title?: string;
	description?: string;
	ogImage?: string;
	structuredData?: JsonLdNode[];
}

const {
	title = 'Korepetycje z historii sztuki online | Matura, olimpiada – Nota Bene Sztuka',
	description = 'Korepetycje z historii sztuki online – przygotowanie do matury, olimpiady i egzaminów wstępnych. Indywidualne lekcje 1:1, małe grupy i webinary.',
	ogImage = '/og-image.jpg',
	structuredData = [],
} = Astro.props;

const siteUrl = import.meta.env.SITE;
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageURL = new URL(ogImage, siteUrl).href;
const ogImageAlt = 'Nota Bene Sztuka - Korepetycje z historii sztuki';
const jsonLd = {
	'@context': 'https://schema.org',
	'@graph': [...createBaseStructuredData(siteUrl), ...structuredData],
};
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />

		<!-- Canonical -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:secure_url" content={ogImageURL} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:site_name" content="Nota Bene Sztuka" />

		<!-- Twitter Card -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		<!-- Site identity -->
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="theme-color" content="#dfd5c3" />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Outfit:wght@400;500;600;700&family=Playfair+Display:wght@400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>

		<!-- JSON-LD Structured Data -->
		<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style>
	:root {
		--container-max: 68.75rem;
		--header-height: 4.5rem;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: calc(var(--header-height) + 2rem);
		overflow-x: hidden;
	}

	body {
		margin: 0;
		min-height: 100vh;
		font-family:
			'Outfit',
			system-ui,
			-apple-system,
			sans-serif;
		background: #dfd5c3;
		color: #111;
	}

	.container {
		max-width: var(--container-max);
		margin: 0 auto;
		padding: 0 1rem;
	}
</style>
